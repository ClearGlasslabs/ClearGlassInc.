# Never commit live secret values.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Comma-separated Stripe Price IDs that this API may sell.
STRIPE_ALLOWED_PRICE_IDS=price_replace_me

# payment or subscription
STRIPE_CHECKOUT_MODE=payment

# Use HTTPS in production.
STRIPE_SUCCESS_URL=https://www.clearglassinc.com/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://www.clearglassinc.com/payment/cancelled
