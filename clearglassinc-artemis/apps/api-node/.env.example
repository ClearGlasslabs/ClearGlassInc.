# Never commit live secret values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Comma-separated Stripe Price IDs that this API may sell.
STRIPE_ALLOWED_PRICE_IDS=

# payment or subscription
STRIPE_CHECKOUT_MODE=

# Use HTTPS in production.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Generate independent >=32-byte random values; never reuse or commit them.
ARTEMIS_ADMIN_API_TOKEN=
ARTEMIS_OPERATOR_API_TOKEN=
ARTEMIS_INGEST_API_TOKEN=
GUMROAD_WEBHOOK_SECRET=
ALLOWED_ORIGINS=

# --- Membership subscriptions (names only; set values in the deployment secret store) ---
# Runtime mode. No authentication bypass exists in any mode.
NODE_ENV=
# Public origins. APP_BASE_URL is the account/API origin (HTTPS in production);
# SITE_BASE_URL is the static website origin allowed to read public plan state.
APP_BASE_URL=
SITE_BASE_URL=

# Postgres (authoritative subscriber data). DATABASE_SSL: empty, require, or no-verify.
DATABASE_URL=
DATABASE_SSL=

# >=32 random characters; keys the hashing of login/session tokens.
AUTH_SECRET=

# Stripe Price IDs (same Stripe mode as STRIPE_SECRET_KEY). Leave unset to mark an offer unconfigured.
STRIPE_PRICE_SIGNAL_MONTHLY=
STRIPE_PRICE_SIGNAL_ANNUAL=
STRIPE_PRICE_ASSURANCE_MONTHLY=
STRIPE_PRICE_ASSURANCE_ANNUAL=
# Optional: when unset, Northstar is contact/request-access only.
STRIPE_PRICE_NORTHSTAR_ENTERPRISE=

# Optional policy and Stripe settings.
SUBSCRIPTION_TRIAL_ACCESS=
SUBSCRIPTION_ACCESS_GRACE_SECONDS=
STRIPE_AUTOMATIC_TAX=
STRIPE_PORTAL_CONFIGURATION_ID=
NORTHSTAR_CONTACT_URL=

# Transactional email (SMTP) for passwordless sign-in links.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Redis (existing webhook queue).
REDIS_URL=

# Deployment (GitHub Actions secrets / Render): names only.
RENDER_DEPLOY_HOOK_URL=
RENDER_WORKER_DEPLOY_HOOK_URL=
